# Source-development and legacy environment-variable compatibility only.
# Normal deployments should configure providers in the encrypted Provider Store UI.
# If this file is copied to `.env`, keep it local and never commit credentials.
TRACEABLE_RAG_DATA_DIR=./.runtime/dev-data-v3
TRACEABLE_RAG_PORT=8000
TRACEABLE_RAG_DEV_SECRET_DIR=./.runtime/dev-secrets

# Traceable-RAG compatibility runtime configuration
#
# Final-user Docker installs configure Providers through the authenticated local
# management page and encrypted provider store. This file exists for source
# development, compatibility tests, and controlled release acceptance only.
# Every Provider field is empty by default so copying the template never creates
# a fake configured state. Process environment variables override `.env`.
# Parsing accepts NAME=VALUE, quotes, comments, and optional `export `.
# Inline comments are not supported, and escape sequences are not processed.

# MinerU document parser (independent role).
TRACEABLE_RAG_MINERU_ADAPTER=
TRACEABLE_RAG_MINERU_BASE_URL=
MINERU_TOKEN=
TRACEABLE_RAG_MINERU_MODEL=

# Embedding Provider (independent role).
TRACEABLE_RAG_EMBEDDING_ADAPTER=
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_QUERY_PROMPT=

# Reranker Provider (independent role; no longer needs to share Embedding credentials).
TRACEABLE_RAG_RERANKER_ADAPTER=
TRACEABLE_RAG_RERANKER_BASE_URL=
TRACEABLE_RAG_RERANKER_API_KEY=
TRACEABLE_RAG_RERANKER_MODEL=

# Optional LLM Provider. This release only saves and connection-tests this role;
# Traceable-RAG does not use it to generate answers.
TRACEABLE_RAG_LLM_ADAPTER=
TRACEABLE_RAG_LLM_BASE_URL=
TRACEABLE_RAG_LLM_API_KEY=
TRACEABLE_RAG_LLM_MODEL=

# Runtime paths. Empty values use application defaults; containers override them.
TRACEABLE_RAG_DATABASE_PATH=
TRACEABLE_RAG_MANAGED_STORAGE_ROOT=
TRACEABLE_RAG_SETTINGS_PATH=
TRACEABLE_RAG_STATIC_DIR=
TRACEABLE_RAG_PROVIDER_STORE_PATH=
TRACEABLE_RAG_MASTER_KEY_FILE=
TRACEABLE_RAG_ADMIN_TOKEN_FILE=
